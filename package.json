{
  "name": "@sakana-y/siz",
  "version": "0.3.2",
  "description": "Smarter npm package search & management CLI — search, favorite and install packages.",
  "keywords": [
    "cli",
    "discovery",
    "favorites",
    "npm",
    "packages",
    "search"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaKaNa-Y/Siz.git"
  },
  "bin": {
    "siz": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown --config-loader tsx",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "prepublishOnly": "pnpm run build",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm format:fix",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "@clack/core": "^1.4.1",
    "@clack/prompts": "^1.5.1",
    "ansis": "^4.3.1",
    "cac": "^7.0.0",
    "fast-npm-meta": "^2.0.0",
    "fzf": "^0.5.2",
    "package-manager-detector": "^1.6.0",
    "semver": "^7.8.1",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^20.19.0",
    "@types/semver": "^7.7.1",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "tsdown": "^0.22.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.24.0"
}
